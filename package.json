{
  "name": "ops-dashboard",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "dev": "pnpm --filter @ops-dashboard/web dev",
    "build": "corepack pnpm --recursive run build",
    "lint": "corepack pnpm --recursive run lint",
    "typecheck": "corepack pnpm --recursive run typecheck",
    "test": "corepack pnpm --recursive run test",
    "test:e2e": "pnpm --filter @ops-dashboard/web test:e2e",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json}\"",
    "ci:local": "corepack pnpm format:check && corepack pnpm lint && corepack pnpm typecheck && corepack pnpm test && corepack pnpm build",
    "audit:high": "corepack pnpm audit --audit-level=high"
  },
  "pnpm": {
    "overrides": {
      "@serwist/next>browserslist": "4.28.7",
      "next>browserslist": "4.28.7",
      "next>js-yaml": "4.3.2",
      "next>sharp": "0.35.4",
      "@tiptap/core": "3.30.5",
      "@tiptap/pm": "3.30.5",
      "browserslist": "4.28.7",
      "js-yaml": "4.3.2",
      "sharp": "0.35.4"
    }
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.67.0"
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  }
}
