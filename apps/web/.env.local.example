# Supabase sync and authentication
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Server-to-server capture and health authentication
OPS_API_SECRET=
CRON_SECRET=
